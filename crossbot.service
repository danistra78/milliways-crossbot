[Unit]
Description=Cross-Bot Message Bus API (Eddie <-> Marvin)
After=network.target

[Service]
Type=simple
User=crossbot
Group=crossbot
WorkingDirectory=/opt/crossbot
ExecStart=/opt/crossbot/bin/python /opt/crossbot/main.py
EnvironmentFile=/opt/crossbot/env
Restart=always
RestartSec=5

# Haertung: der Dienst lauscht auf 0.0.0.0:9191 und braucht keine Rechte
# ausser Schreibzugriff auf das Datenbank-Verzeichnis. Port > 1024, also
# ist kein CAP_NET_BIND_SERVICE noetig.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# WAL/SHM-Dateien entstehen neben der Datenbank — das Verzeichnis, nicht nur
# die Datei, muss schreibbar sein.
ReadWritePaths=/export/hermes-shared

[Install]
WantedBy=multi-user.target
