# Pflicht: mindestens 32 Zeichen, z. B. via `openssl rand -hex 32`.
# Leer oder Platzhalter => der Dienst startet absichtlich NICHT.
CROSSBOT_API_KEY=
# Die Datenbank muss auf lokalem Speicher liegen (SQLite-WAL funktioniert
# nicht ueber NFS/9p).
CROSSBOT_DB_PATH=/var/lib/crossbot/crossbot.db
CROSSBOT_PORT=9191
CROSSBOT_HOST=0.0.0.0
# Sekunden, die SQLite auf eine belegte Schreibsperre wartet.
CROSSBOT_BUSY_TIMEOUT=5.0
# Aufbewahrung abgeschlossener (done/cancelled) Nachrichten in Tagen.
# <= 0 deaktiviert das automatische Aufraeumen.
CROSSBOT_RETENTION_DAYS=30
# Intervall zwischen Aufraeum-Laeufen in Sekunden.
CROSSBOT_CLEANUP_INTERVAL_SECONDS=3600
